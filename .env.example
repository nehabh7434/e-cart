DB_USER=ecart
DB_HOST=localhost
DB_NAME=ecart
DB_PASSWORD=replace-with-a-local-password
DB_PORT=5432

# Optional Neon PostgreSQL URL; when set, it takes precedence over DB_*.
# Keep this empty locally unless you intentionally want to connect to Neon.
DATABASE_URL=

SESSION_SECRET=replace-with-a-long-random-session-secret
APP_PORT=3000

# Render supplies PORT. COOKIE_SECURE must be true for HTTPS production.
PORT=3000
COOKIE_SECURE=false

# Test database connection. The test runner provisions an isolated database.
TEST_DB_USER=ecart
TEST_DB_HOST=localhost
TEST_DB_PASSWORD=replace-with-a-local-password
TEST_DB_PORT=5432
TEST_DB_NAME=ecart_test
